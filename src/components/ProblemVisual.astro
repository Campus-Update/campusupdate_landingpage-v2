---
import { ChatCircleDots, WarningCircle, Question, ShareNetwork, InstagramLogo, XLogo, UsersThree, Megaphone, MagnifyingGlass, Bell } from '@phosphor-icons/react';

/**
 * Illustrations for the four problem cards. Same language as the bento references:
 * one idea per card, soft glow, a single highlighted (indigo) element among muted ones.
 */
interface Props { n: '01' | '02' | '03' | '04' }
const { n } = Astro.props;
const tile = 'grid place-items-center rounded-2xl bg-white shadow-[0_10px_24px_-14px_rgba(32,28,92,0.5)] ring-1 ring-indigo/10';
const card = 'rounded-2xl bg-white shadow-[0_14px_28px_-16px_rgba(32,28,92,0.5)] ring-1 ring-indigo/10';
---
<div aria-hidden="true" class="relative isolate mx-auto h-[170px] w-full max-w-[250px] select-none">
  <div class="absolute inset-x-4 bottom-0 -z-10 h-24 rounded-full bg-indigo/25 blur-2xl"></div>

  {n === '01' && (
    <div class="flex h-full flex-col items-center justify-center gap-4">
      <div class="relative flex items-center gap-2">
        <span class="absolute inset-x-4 top-1/2 -z-10 border-t border-dashed border-indigo/30"></span>
        <span style="transition-delay:0ms" class={`${tile} size-11 opacity-40 transition-opacity duration-300 group-hover/card:opacity-100`}><ChatCircleDots weight="fill" class="size-5 text-gray" /></span>
        <span style="transition-delay:80ms" class={`${tile} size-11 opacity-65 transition-opacity duration-300 group-hover/card:opacity-100`}><ChatCircleDots weight="fill" class="size-5 text-gray" /></span>
        <span style="transition-delay:160ms" class={`${tile} size-11 opacity-90 transition-opacity duration-300 group-hover/card:opacity-100`}><ChatCircleDots weight="fill" class="size-5 text-gray" /></span>
        <span class="grid size-[60px] place-items-center rounded-2xl bg-indigo text-white shadow-[0_14px_28px_-10px_rgba(79,70,229,0.8)] transition-transform duration-500 ease-[var(--ease-out)] group-hover/card:scale-110">
          <svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="9.5" />
            <line class="pv-hand pv-hour" x1="12" y1="12" x2="12" y2="7.2" />
            <line class="pv-hand pv-minute" x1="12" y1="12" x2="12" y2="5" />
          </svg>
        </span>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-[12px] font-semibold text-[#B42318] shadow-sm ring-1 ring-black/5">
        <WarningCircle weight="fill" class="size-4" />Deadline passed
      </span>
    </div>
  )}

  {n === '02' && (
    <div class="relative size-full">
      <div class="absolute top-2 left-1/2 w-[128px] -translate-x-1/2 rounded-2xl bg-indigo transition-[translate] duration-500 ease-[var(--ease-out)] group-hover/card:-translate-y-1.5 px-4 pt-3 pb-12 text-white shadow-[0_16px_32px_-12px_rgba(79,70,229,0.85)]">
        <p class="text-[10px] font-semibold tracking-widest opacity-80">FRIDAY</p>
        <p class="font-display text-[34px] leading-none">24</p>
      </div>
      <span class="pv-badge absolute top-0 right-5 z-20 rounded-full bg-[#C2410C] px-2 py-0.5 text-[11px] font-bold text-white shadow">99+</span>
      {[
        { top: 62, x: -6, hx: -30, w: 'w-[88%]', o: 'opacity-95' },
        { top: 92, x: 10, hx: 34, w: 'w-[88%]', o: 'opacity-95' },
        { top: 122, x: -2, hx: -26, w: 'w-[88%]', o: 'opacity-95' },
      ].map((m) => (
        <div class={`${card} absolute left-[6%] z-10 flex h-[34px] items-center gap-2 px-2.5 ${m.w} ${m.o} [translate:var(--x)_0] transition-[translate] duration-500 ease-[var(--ease-out)] group-hover/card:[translate:var(--hx)_0]`} style={`top:${m.top}px;--x:${m.x}px;--hx:${m.hx}px`}>
          <Bell weight="fill" class="size-4 shrink-0 text-gray/60" />
          <span class="h-1.5 w-full max-w-[60%] rounded-full bg-gray/25"></span>
          <span class="ml-auto h-1.5 w-6 rounded-full bg-gray/15"></span>
        </div>
      ))}
    </div>
  )}

  {n === '03' && (
    <div class="relative size-full">
      <div class={`${card} absolute top-3 left-[10%] h-[96px] w-[78%] -rotate-[9deg] opacity-50 transition-[rotate,translate] duration-500 ease-[var(--ease-out)] group-hover/card:-rotate-[15deg] group-hover/card:-translate-x-2`}></div>
      <div class={`${card} absolute top-5 left-[12%] h-[96px] w-[78%] rotate-[7deg] opacity-70 transition-[rotate,translate] duration-500 ease-[var(--ease-out)] group-hover/card:rotate-[13deg] group-hover/card:translate-x-2`}></div>
      <div class={`${card} absolute top-6 left-[8%] w-[84%] p-3.5`}>
        <p class="flex items-center gap-1.5 text-[11px] font-medium text-gray"><ShareNetwork class="size-3.5" />Forwarded many times</p>
        <p class="mt-2 text-[14px] leading-snug font-semibold text-ink">Exam moved to Thursday</p>
        <span class="mt-2.5 inline-flex items-center rounded-full border border-dashed border-gray/50 px-2 py-0.5 text-[11px] font-medium text-gray">Source unknown</span>
      </div>
      <span class="pv-glow absolute top-0 right-3 z-10 grid size-11 place-items-center rounded-full bg-indigo text-white shadow-[0_0_0_6px_rgba(79,70,229,0.18),0_14px_26px_-8px_rgba(79,70,229,0.9)]"><Question weight="bold" class="size-6" /></span>
    </div>
  )}

  {n === '04' && (
    <div class="relative size-full">
      <span class={`${tile} absolute top-2 left-1 size-12 -rotate-[8deg] opacity-80 transition-[translate,rotate] duration-500 ease-[var(--ease-out)] group-hover/card:[translate:-8px_-6px]`}><ChatCircleDots weight="fill" class="size-6 text-gray" /></span>
      <span class={`${tile} absolute top-0 left-[40%] size-11 rotate-[6deg] opacity-65 transition-[translate,rotate] duration-500 ease-[var(--ease-out)] group-hover/card:[translate:0px_-8px]`}><InstagramLogo class="size-6 text-gray" /></span>
      <span class={`${tile} absolute top-5 right-1 size-12 rotate-[9deg] opacity-80 transition-[translate,rotate] duration-500 ease-[var(--ease-out)] group-hover/card:[translate:8px_-4px]`}><XLogo class="size-5 text-gray" /></span>
      <span class={`${tile} absolute bottom-3 left-0 size-11 rotate-[7deg] opacity-65 transition-[translate,rotate] duration-500 ease-[var(--ease-out)] group-hover/card:[translate:-8px_6px]`}><UsersThree weight="fill" class="size-6 text-gray" /></span>
      <span class={`${tile} absolute right-[14%] bottom-0 size-12 -rotate-[6deg] opacity-80 transition-[translate,rotate] duration-500 ease-[var(--ease-out)] group-hover/card:[translate:6px_8px]`}><Megaphone weight="fill" class="size-6 text-gray" /></span>
      <span class="pv-glow absolute top-1/2 left-1/2 z-10 grid size-[64px] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-2xl bg-indigo text-white shadow-[0_0_0_7px_rgba(79,70,229,0.16),0_16px_30px_-10px_rgba(79,70,229,0.9)]"><MagnifyingGlass weight="bold" class="size-7" /></span>
    </div>
  )}
</div>
