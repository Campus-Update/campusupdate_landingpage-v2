---
import { ArrowRight } from '@phosphor-icons/react';
import Logo from './Logo.astro';
import MobileNav from './MobileNav';
import LocalClock from './LocalClock';
import { buttonVariants } from '@/components/ui/button';
import { nav, site } from '../data/site';
---
<header data-site-header class="sticky top-0 z-40 bg-white/85 backdrop-blur-md backdrop-saturate-150 transition-shadow duration-300 data-[scrolled=true]:shadow-[0_10px_30px_-18px_rgba(16,24,40,0.28)]">
  <div class="wrap grid h-[72px] grid-cols-[1fr_auto] items-center sm:h-[88px] md:grid-cols-[1fr_auto_1fr]">
    <div class="flex items-center justify-self-start whitespace-nowrap"><Logo /></div>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {nav.map((l) => (
        <a href={l.href} class="rounded-full px-4 py-2 text-[16px] font-medium text-ink-strong no-underline transition-colors hover:bg-lavender hover:text-indigo">
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5 justify-self-end">
      <div class="hidden lg:block"><LocalClock client:idle /></div>
      <div class="hidden md:block">
        <a class={buttonVariants({ variant: 'brand', size: 'md' })} href={site.links.app}>
          Go to app
          <ArrowRight weight="bold" aria-hidden="true" />
        </a>
      </div>
      <MobileNav client:idle links={nav} appHref={site.links.app} />
    </div>
  </div>
</header>

<script>
  // Soft shadow under the sticky nav once the page has scrolled.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.setAttribute('data-scrolled', String(window.scrollY > 8));
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
