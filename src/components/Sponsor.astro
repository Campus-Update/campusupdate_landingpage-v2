---
import { sponsor } from '../data/site';
const logo = `<img src="${sponsor.logo}" alt="${sponsor.name}" width="900" height="314" loading="lazy" decoding="async" class="h-14 w-auto sm:h-16" />`;
---
<section class="wrap pt-6 pb-[clamp(8px,2vw,24px)]" aria-label={`${sponsor.label} ${sponsor.name}`}>
  <div data-reveal="fade" class="flex flex-col items-center justify-center gap-1 sm:flex-row sm:gap-5">
    <p class="m-0 text-[13px] font-semibold tracking-[0.1em] text-gray uppercase">{sponsor.label}</p>
    <span aria-hidden="true" class="hidden h-8 w-px bg-ink/15 sm:block"></span>
    {sponsor.href
      ? <a href={sponsor.href} target="_blank" rel="noopener sponsored" class="inline-flex min-h-11 items-center" set:html={logo} />
      : <span class="inline-flex items-center" set:html={logo} />}
  </div>
</section>
